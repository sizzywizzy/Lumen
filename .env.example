# Copy to .env for local dev. When deployed, set the same names in the host's
# environment settings instead (render.yaml lists the API's). Everything is
# optional - the pipeline runs fully on mock data with no keys set. Values may
# be quoted or not.

# --- Gemini, free tier: powers every agent (about 25 calls per pipeline run,
# 9 per simulation, 1-10 per advisor run, 1-2 per poster). Lumen uses no paid
# Gemini features; keep billing off on the key's Google project. ---
GEMINI_API_KEY=
# Model ids verified against a live key; override if your key differs.
# GEMINI_FLASH_MODEL=gemini-3.6-flash
# GEMINI_PRO_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview
# GEMINI_MAX_CONCURRENCY=3
# GEMINI_TIMEOUT_MS=60000
# Characters of an uploaded screenplay each model read gets (profiler, scene
# breakdown, audience analysis). 120000 covers a full feature script.
# SCRIPT_ANALYSIS_MAX_CHARS=120000

# --- Supabase: shared persistence for state, accounts and simulations ---
# Required for any hosted deploy (Render included): their filesystems do not
# survive a redeploy. Apply backend/schema_auth.sql, backend/schema_skills.sql
# and backend/schema_state.sql to the project first. Use the secret key
# (service role): the tables enable row level security with no policies, so the
# publishable/anon key cannot read them.
SUPABASE_URL=
SUPABASE_KEY=
# auto (default) | supabase (require it) | local (always JSON files)
# LUMEN_STATE_BACKEND=auto
# Where the local JSON files go (default backend/.state/).
# LUMEN_STATE_DIR=

# --- Tavily: optional, free plan 1,000 searches a month. The talent scout's
# web search (two searches per run) and the audience simulator's
# cultural/censorship research. Left blank, the scout shows a labelled demo
# cast and that research is disabled, never faked. ---
TAVILY_API_KEY=

# --- TMDb: optional, free for non-commercial use (credit TMDB, as the actor
# card does). Adds a headshot, known-for credits and a TMDB link to each actor
# the scout finds on the web, when exactly one TMDb actor has that name. ---
TMDB_API_KEY=
# Actor knowledge base (optional): the TMDb import into PostgreSQL + pgvector.
# Run backend/migrations/001_actor_knowledge_base.sql against the database.
DATABASE_URL=
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIMENSIONS=384

# --- CORS: browser origins allowed to call the API, comma-separated. Defaults
# to "*". A public deploy names its frontend, e.g. https://lumen.vercel.app ---
# LUMEN_CORS_ORIGINS=

# --- Proxies in front of the API that append to X-Forwarded-For (1 on Render).
# The sign-in rate limit counts attempts per client address. ---
# LUMEN_TRUSTED_PROXY_HOPS=0

# --- Agent skills: skills/<name>/SKILL.md next to backend/ by default. Only set
# this when the folder lives elsewhere (see skills.md). ---
# LUMEN_SKILLS_DIR=
