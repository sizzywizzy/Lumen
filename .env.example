# Copy to .env (or Replit Secrets). Everything is optional - the pipeline
# runs fully on mock data with no keys set.

# --- Gemini: powers every agent (14 calls per pipeline run, 9 per simulation) ---
GEMINI_API_KEY=
# Model ids verified against a live key; override if your key differs.
# GEMINI_FLASH_MODEL=gemini-3.6-flash
# GEMINI_PRO_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview
# GEMINI_MAX_CONCURRENCY=3
# GEMINI_TIMEOUT_MS=60000

# --- Supabase: shared persistence for state, accounts and simulations ---
# Required on Replit/Cloud Run (their filesystems do not survive a redeploy).
# Apply backend/schema_auth.sql to the project first.
SUPABASE_URL=
SUPABASE_KEY=
# auto (default) | supabase (require it) | local (always JSON files)
# CINENODE_STATE_BACKEND=auto

# --- Tavily: optional. Enables web-grounded cultural/censorship research in
# the audience simulator. Left blank, that research is disabled, never faked. ---
TAVILY_API_KEY=
