# Copy to .env (or Replit Secrets). Everything is optional — the pipeline
# runs fully on mock data with no keys set.
GEMINI_API_KEY=
# Model ids are verified against a live key; override if your key differs.
# GEMINI_FLASH_MODEL=gemini-3.6-flash
# GEMINI_PRO_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview
# GEMINI_MAX_CONCURRENCY=3
# GEMINI_TIMEOUT_MS=60000
SUPABASE_URL=
SUPABASE_KEY=
# Optional: enables web-grounded cultural/censorship research in the audience
# simulator. Left blank, that research is disabled (never faked).
TAVILY_API_KEY=
WHISPER_API_KEY=
IMAGEN_API_KEY=

# Google Cloud SQL (takes precedence over Supabase when configured)
CLOUD_SQL_CONNECTION_NAME=
DB_USER=
DB_PASS=
DB_NAME=
