{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lumen/contracts/global_state.json",
  "title": "GlobalState",
  "description": "The one JSON object passed through the entire pipeline. See AGENT.md Section 3. Changing this file requires whole-team agreement.",
  "type": "object",
  "required": ["project_id"],
  "properties": {
    "project_id": { "type": "string", "pattern": "^PROJ_[A-Z0-9_]+$" },
    "locality": { "type": "string", "description": "where the production films; drives local casting" },
    "director_notes": { "type": "string" },
    "script_context": {
      "type": "object",
      "description": "the brief (title, genre, tone, demographic targets, IP params), the screenplay from intake (raw_text and its metadata), and Phase III's scene breakdown (scenes: scene_id, heading, title, tags, assets, ...)"
    },
    "role_requirements": {
      "type": "object",
      "description": "machine-readable casting mandates, keyed by role_id"
    },
    "scoring_weights": {
      "type": "object",
      "properties": {
        "W_A": { "type": "number" },
        "W_H": { "type": "number" },
        "W_PR": { "type": "number" },
        "W_B": { "type": "number" }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "status"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "role_id": { "type": "string" },
          "metadata": { "type": "object" },
          "media_url": { "type": "string" },
          "scores": {
            "type": "object",
            "description": "audition / hype / pr / budget / composite, each 0-100"
          },
          "status": {
            "type": "string",
            "enum": ["SOURCING", "SCREENING", "LOCKED", "DISQUALIFIED", "FLAGGED_ACTION_REQUIRED"]
          },
          "disqualify_reason": { "type": "string", "description": "a plain-language sentence; metadata.disqualify_code holds pr_risk or over_budget" }
        }
      }
    },
    "casting_status": { "type": "string", "enum": ["SOURCING", "SCREENING", "LOCKED"] },
    "schedule": {
      "type": "object",
      "properties": {
        "stripboard": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scene_id": { "type": "string" },
              "heading": { "type": "string", "description": "screenplay slugline" },
              "title": { "type": "string", "description": "short plain-English scene name" },
              "summary": { "type": "string" },
              "date": { "type": "string" },
              "venue": { "type": "string" },
              "location_type": { "type": "string" },
              "int_ext": { "type": "string" },
              "estimated_time_hours": { "type": "number" },
              "characters_needed": { "type": "array", "items": { "type": "string" } },
              "cost_per_day": { "type": "number" },
              "status": { "type": "string", "enum": ["PLANNED", "PARTIAL", "COMPLETED"] },
              "director_note": { "type": "string" }
            }
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scene_id": { "type": "string" },
              "title": { "type": "string" },
              "wanted": { "type": "string" },
              "moved_to": { "type": "string" },
              "venue": { "type": "string" },
              "reason": { "type": "string", "enum": ["venue_unavailable", "past_wrap", "cast_unavailable"] },
              "days_past_wrap": { "type": "integer" },
              "resolution": { "type": "string", "description": "a plain-language sentence" }
            }
          }
        },
        "director_constraints": { "type": "object" },
        "shoot_settings": {
          "type": "object",
          "properties": {
            "start_date": { "type": "string", "format": "date" },
            "end_date": { "type": "string", "format": "date" },
            "min_hours_per_day": { "type": "number" },
            "max_hours_per_day": { "type": "number" }
          }
        },
        "shoot_notes": { "type": "array" },
        "reshoots": { "type": "array" }
      }
    },
    "budget_state": {
      "type": "object",
      "description": "cap is the total production budget (USD) entered at intake or in Settings; it drives casting caps, venue choices and territory reach. total_budget, spent and remaining are derived (cap, the sum of expenses, and the difference) and written for readers only",
      "properties": {
        "daily_burn": { "type": "number" },
        "cap": { "type": "number" },
        "alerts": { "type": "array" },
        "expenses": { "type": "array", "description": "logged by the team; starts empty" },
        "total_budget": { "type": "number", "description": "derived: equals cap" },
        "spent": { "type": "number", "description": "derived: sum of expenses" },
        "remaining": { "type": "number", "description": "derived: cap - spent" }
      }
    },
    "compliance_state": {
      "type": "object",
      "description": "keyed by territory code",
      "additionalProperties": {
        "type": "string",
        "enum": ["CLEARED", "AWAITING_QC", "BLOCKED"]
      }
    },
    "audience_report": {
      "type": "object",
      "properties": {
        "tomatometer": { "type": "number" },
        "audience_score": { "type": "number" },
        "heatmap": { "type": "object" },
        "weakest_scene_id": { "type": "string" },
        "weakest_scene_title": { "type": "string" },
        "scene_titles": { "type": "object", "description": "scene_id -> title" },
        "viewer_count": { "type": "integer" },
        "verdict": { "type": "string", "enum": ["", "fresh", "rotten"] },
        "screening_source": { "type": "string", "enum": ["", "live", "mixed", "offline"], "description": "who scored the scenes: the model, partly the model, or the stated offline rules" },
        "reviews": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "quote"],
            "properties": {
              "source": { "type": "string" },
              "kind": { "type": "string", "enum": ["critic", "viewer"] },
              "quote": { "type": "string" },
              "score": { "type": "string" }
            }
          }
        }
      }
    },
    "marketing_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "type", "status"],
        "properties": {
          "asset_id": { "type": "string" },
          "type": { "type": "string", "enum": ["reel", "meme", "poster", "thumbnail", "copy", "press_release"] },
          "status": {
            "type": "string",
            "enum": ["DRAFT", "PR_REVIEW", "BLOCKED", "APPROVED", "SCHEDULED", "POSTED"]
          },
          "source_scene_id": { "type": "string" }
        }
      }
    },
    "human_escalations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "queue_item": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "event_log": {
      "type": "array",
      "description": "every A2A envelope, in order",
      "items": { "$ref": "a2a_envelope.json" }
    }
  }
}
